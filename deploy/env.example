# Set these in ModelScope Studio runtime environment variables (NOT in Git).
# Generate hex passwords with: openssl rand -hex 24
# Generate ENCRYPTION_KEY with: openssl rand -hex 32
# This image deliberately does NOT use /mnt/workspace.

POSTGRES_PASSWORD=REPLACE_WITH_AT_LEAST_32_HEX_CHARACTERS
POSTGRES_APP_PASSWORD=REPLACE_WITH_DIFFERENT_32_PLUS_HEX_CHARACTERS
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_HEX_CHARACTERS
SCREEN_PROXY_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
OWNER_EMAIL=your-email@example.com
OWNER_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS

BETTER_AUTH_URL=https://rakazo.example.com
WEB_ORIGIN=https://rakazo.example.com
RAKAZO_HOST=rakazo.example.com
RAKAZO_ALLOWED_HOSTS=rakazo.example.com
API_URL=https://rakazo.example.com

# Cloudflare remotely-managed Tunnel, route public hostname to http://127.0.0.1:5173
TUNNEL_TOKEN=REPLACE_WITH_YOUR_CLOUDFLARE_TUNNEL_TOKEN

# Root Chrome is started with --no-sandbox by the entrypoint. This is unsafe: use only for private tests.
DESKTOP_RESOLUTION=1366x768x24

# Screen streaming runs internally at 127.0.0.1:5900/6080, with a view-only VNC backend.
# No screen-domain, VNC token, second Tunnel, or extra external port is required.
